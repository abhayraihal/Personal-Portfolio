{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/use-memo": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}
